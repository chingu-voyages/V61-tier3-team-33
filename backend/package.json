{
  "name": "backend",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ migrate/scripts/",
    "lint:fix": "eslint src/ migrate/scripts/ --fix",
    "format": "prettier --check 'src/' 'migrate/scripts/'",
    "format:fix": "prettier --write 'src/' 'migrate/scripts/'",
    "test": "bun test",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "migrate": "bun run migrate/scripts/cli.ts",
    "migrate:down": "bun run migrate/scripts/cli.ts --down"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "elysia": "^1.4.29",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/ws": "^8.18.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "prettier": "^3.9.5",
    "typescript-eslint": "^8.63.0",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  }
}
