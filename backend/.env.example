# Server
NODE_ENV=development          # development | production
PORT=3000                     # Port the server listens on
CLIENT_URL=http://localhost:5173

# Logging
LOG_ENABLED=true              # Master on/off for logging
LOG_LEVEL=debug               # Minimum level: debug | info | warn | error
LOG_FORMAT=pretty             # pretty | json
LOG_EXCLUDE=                  # Comma-separated event types to suppress
LOG_SAMPLE=                   # e.g. MOVE_MADE=0.1,ROOM_JOINED=0.5 (rate in [0,1])
LOG_FILE=                     # Optional path to also persist logs as ndjson (e.g. ./logs/server.log)

# Postgres
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=
PG_USER=postgres
PG_PASSWORD=
PG_POOL_MAX=10                # Connection pool size (Bun pool max)
PG_IDLE_TIMEOUT=30            # Seconds before idle connection is released
PG_CONNECT_TIMEOUT=10         # Seconds before connection attempt times out
PG_TLS=false                  # true | false — enables TLS for Postgres
PG_MAX_LIFETIME=1800          # Seconds a connection lives before being replaced (30m)
